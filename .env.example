# Copia este archivo a .env en el servidor y completa los valores reales.
# NUNCA subas .env a git.

# Conexión interna Docker (el contenedor alcanza postgres_db por DNS de la red
# postgresql_default). Formato de GUIA_VPS.md:
# postgresql://USUARIO:CONTRASENA@postgres_db:5432/raicescare_db
DATABASE_URL=

# Puerto del host que publica la API. Verificar que esté libre con `ss -ltn`
# antes de levantar: el mapa de puertos de la guía está desactualizado.
API_HOST_PORT=8221

# Puerto interno del contenedor (no cambiar salvo necesidad).
PORT=3001

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=https://www.raicescare.earth,https://raicescare.earth

# URL pública del sitio. Se usa para armar las URLs de retorno de MercadoPago.
PUBLIC_SITE_URL=https://www.raicescare.earth

# MercadoPago — aplicación `raicescare_aportes` (Checkout Pro + Suscripciones).
# Un solo token: el de prueba mientras se valida, el de producción al salir.
# El de producción mueve plata real; tratarlo como contraseña.
MP_ACCESS_TOKEN=

# Secreto de firma del webhook. Se genera en el panel de MercadoPago, en
# Webhooks, al registrar la URL de notificaciones. Sin él la API rechaza todas
# las notificaciones: cualquiera que conociera la URL podría dar un aporte por
# aprobado. Cada modo del panel (prueba y producción) genera el suyo: se
# admiten varios separados por coma.
MP_WEBHOOK_SECRET=
